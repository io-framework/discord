{
    "name": "io/discord-demo",
    "description": "A radio bot as an Io app: slash commands, a voice channel and a status page.",
    "type": "project",
    "license": "MIT OR Apache-2.0",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "versions": {
                    "io/discord": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.5",
        "io/discord": "^0.1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Demo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Demo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
