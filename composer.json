{
    "name": "io/discord",
    "description": "Discord bots in Io apps: slash commands, buttons, modals and events as attributes on your own classes, running on Tenma with tenma/discord.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "io/framework": "^0.1.0",
        "tenma/discord": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "tenma/stubs": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Io\\Discord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Io\\Discord\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
